{
    "terraform":  {
                      "required_version":  "\u003e= 1.5",
                      "required_providers":  {
                                                 "aws":  {
                                                             "source":  "hashicorp/aws",
                                                             "version":  "~\u003e 6.0"
                                                         },
                                                 "archive":  {
                                                                 "source":  "hashicorp/archive",
                                                                 "version":  "~\u003e 2.7"
                                                             }
                                             }
                  },
    "variable":  {
                     "region":  {
                                    "type":  "string",
                                    "default":  "us-east-1"
                                }
                 },
    "provider":  {
                     "aws":  {
                                 "region":  "${var.region}"
                             }
                 },
    "locals":  {
                   "name":  "aws-security-log-demo",
                   "bucket_name":  "${local.name}-${data.aws_caller_identity.current.account_id}-${var.region}"
               },
    "data":  {
                 "aws_caller_identity":  {
                                             "current":  {

                                                         }
                                         },
                 "aws_vpc":  {
                                 "default":  {
                                                 "default":  true
                                             }
                             },
                 "aws_subnets":  {
                                     "default":  {
                                                     "filter":  [
                                                                    {
                                                                        "name":  "vpc-id",
                                                                        "values":  [
                                                                                       "${data.aws_vpc.default.id}"
                                                                                   ]
                                                                    },
                                                                    {
                                                                        "name":  "default-for-az",
                                                                        "values":  [
                                                                                       "true"
                                                                                   ]
                                                                    }
                                                                ]
                                                 }
                                 },
                 "aws_ssm_parameter":  {
                                           "al2023":  {
                                                          "name":  "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
                                                      }
                                       },
                 "archive_file":  {
                                      "detector":  {
                                                       "type":  "zip",
                                                       "output_path":  "${path.module}/detector.zip",
                                                       "source":  [
                                                                      {
                                                                          "filename":  "detector.py",
                                                                          "content":  "${file(\"${path.module}/detector.py\")}"
                                                                      },
                                                                      {
                                                                          "filename":  "handler.py",
                                                                          "content":  "${file(\"${path.module}/handler.py\")}"
                                                                      }
                                                                  ]
                                                   }
                                  }
             },
    "resource":  {
                     "aws_s3_bucket":  {
                                           "logs":  {
                                                        "bucket":  "${local.bucket_name}",
                                                        "force_destroy":  true
                                                    }
                                       },
                     "aws_s3_bucket_public_access_block":  {
                                                               "logs":  {
                                                                            "bucket":  "${aws_s3_bucket.logs.id}",
                                                                            "block_public_acls":  true,
                                                                            "block_public_policy":  true,
                                                                            "ignore_public_acls":  true,
                                                                            "restrict_public_buckets":  true
                                                                        }
                                                           },
                     "aws_s3_bucket_server_side_encryption_configuration":  {
                                                                                "logs":  {
                                                                                             "bucket":  "${aws_s3_bucket.logs.id}",
                                                                                             "rule":  {
                                                                                                          "apply_server_side_encryption_by_default":  {
                                                                                                                                                          "sse_algorithm":  "AES256"
                                                                                                                                                      }
                                                                                                      }
                                                                                         }
                                                                            },
                     "aws_s3_bucket_policy":  {
                                                  "logs":  {
                                                               "bucket":  "${aws_s3_bucket.logs.id}",
                                                               "policy":  "${jsonencode({\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Deny\",\"Principal\":\"*\",\"Action\":\"s3:*\",\"Resource\":[aws_s3_bucket.logs.arn,\"${aws_s3_bucket.logs.arn}/*\"],\"Condition\":{\"Bool\":{\"aws:SecureTransport\":\"false\"}}}]})}"
                                                           }
                                              },
                     "aws_s3_bucket_lifecycle_configuration":  {
                                                                   "logs":  {
                                                                                "bucket":  "${aws_s3_bucket.logs.id}",
                                                                                "rule":  {
                                                                                             "id":  "expire-demo-logs",
                                                                                             "status":  "Enabled",
                                                                                             "filter":  {
                                                                                                            "prefix":  "logs/"
                                                                                                        },
                                                                                             "expiration":  {
                                                                                                                "days":  7
                                                                                                            }
                                                                                         }
                                                                            }
                                                               },
                     "aws_sqs_queue":  {
                                           "dead":  {
                                                        "name":  "${local.name}-dlq",
                                                        "sqs_managed_sse_enabled":  true,
                                                        "message_retention_seconds":  345600
                                                    },
                                           "events":  {
                                                          "name":  "${local.name}-events",
                                                          "sqs_managed_sse_enabled":  true,
                                                          "visibility_timeout_seconds":  120,
                                                          "redrive_policy":  "${jsonencode({deadLetterTargetArn = aws_sqs_queue.dead.arn, maxReceiveCount = 5})}"
                                                      }
                                       },
                     "aws_sqs_queue_policy":  {
                                                  "from_s3":  {
                                                                  "queue_url":  "${aws_sqs_queue.events.url}",
                                                                  "policy":  "${jsonencode({\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sqs:SendMessage\",\"Resource\":aws_sqs_queue.events.arn,\"Principal\":{\"Service\":\"s3.amazonaws.com\"},\"Condition\":{\"ArnEquals\":{\"aws:SourceArn\":aws_s3_bucket.logs.arn},\"StringEquals\":{\"aws:SourceAccount\":data.aws_caller_identity.current.account_id}}}]})}"
                                                              }
                                              },
                     "aws_s3_bucket_notification":  {
                                                        "events":  {
                                                                       "bucket":  "${aws_s3_bucket.logs.id}",
                                                                       "queue":  {
                                                                                     "queue_arn":  "${aws_sqs_queue.events.arn}",
                                                                                     "events":  [
                                                                                                    "s3:ObjectCreated:Put"
                                                                                                ],
                                                                                     "filter_prefix":  "logs/",
                                                                                     "filter_suffix":  ".json"
                                                                                 },
                                                                       "depends_on":  [
                                                                                          "aws_sqs_queue_policy.from_s3"
                                                                                      ]
                                                                   }
                                                    },
                     "aws_dynamodb_table":  {
                                                "findings":  {
                                                                 "name":  "${local.name}-findings",
                                                                 "billing_mode":  "PAY_PER_REQUEST",
                                                                 "hash_key":  "finding_id",
                                                                 "attribute":  {
                                                                                   "name":  "finding_id",
                                                                                   "type":  "S"
                                                                               }
                                                             }
                                            },
                     "aws_cloudwatch_log_group":  {
                                                      "detector":  {
                                                                       "name":  "/aws/lambda/${local.name}",
                                                                       "retention_in_days":  7
                                                                   }
                                                  },
                     "aws_cloudwatch_metric_alarm":  {
                                                         "dead_letter":  {
                                                                             "alarm_name":  "${local.name}-dlq-visible",
                                                                             "namespace":  "AWS/SQS",
                                                                             "metric_name":  "ApproximateNumberOfMessagesVisible",
                                                                             "dimensions":  {
                                                                                                "QueueName":  "${aws_sqs_queue.dead.name}"
                                                                                            },
                                                                             "statistic":  "Maximum",
                                                                             "comparison_operator":  "GreaterThanOrEqualToThreshold",
                                                                             "threshold":  1,
                                                                             "period":  60,
                                                                             "evaluation_periods":  1,
                                                                             "treat_missing_data":  "notBreaching"
                                                                         }
                                                     },
                     "aws_iam_role":  {
                                          "detector":  {
                                                           "name":  "${local.name}-lambda-${var.region}",
                                                           "assume_role_policy":  "${jsonencode({\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRole\",\"Principal\":{\"Service\":\"lambda.amazonaws.com\"}}]})}"
                                                       },
                                          "producer":  {
                                                           "name":  "${local.name}-ec2-${var.region}",
                                                           "assume_role_policy":  "${jsonencode({\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRole\",\"Principal\":{\"Service\":\"ec2.amazonaws.com\"}}]})}"
                                                       }
                                      },
                     "aws_iam_role_policy":  {
                                                 "detector":  {
                                                                  "name":  "process-logs",
                                                                  "role":  "${aws_iam_role.detector.id}",
                                                                  "policy":  "${jsonencode({\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"sqs:ReceiveMessage\",\"sqs:DeleteMessage\",\"sqs:GetQueueAttributes\"],\"Resource\":aws_sqs_queue.events.arn},{\"Effect\":\"Allow\",\"Action\":\"s3:GetObject\",\"Resource\":\"${aws_s3_bucket.logs.arn}/logs/*\"},{\"Effect\":\"Allow\",\"Action\":\"dynamodb:PutItem\",\"Resource\":aws_dynamodb_table.findings.arn},{\"Effect\":\"Allow\",\"Action\":[\"logs:CreateLogStream\",\"logs:PutLogEvents\"],\"Resource\":\"${aws_cloudwatch_log_group.detector.arn}:*\"}]})}"
                                                              },
                                                 "producer":  {
                                                                  "name":  "upload-logs",
                                                                  "role":  "${aws_iam_role.producer.id}",
                                                                  "policy":  "${jsonencode({\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"s3:PutObject\",\"Resource\":\"${aws_s3_bucket.logs.arn}/logs/*\"}]})}"
                                                              }
                                             },
                     "aws_lambda_function":  {
                                                 "detector":  {
                                                                  "function_name":  "${local.name}",
                                                                  "role":  "${aws_iam_role.detector.arn}",
                                                                  "filename":  "${data.archive_file.detector.output_path}",
                                                                  "source_code_hash":  "${data.archive_file.detector.output_base64sha256}",
                                                                  "runtime":  "python3.12",
                                                                  "handler":  "handler.lambda_handler",
                                                                  "timeout":  20,
                                                                  "memory_size":  128,
                                                                  "environment":  {
                                                                                      "variables":  {
                                                                                                        "LOG_BUCKET":  "${aws_s3_bucket.logs.id}",
                                                                                                        "FINDINGS_TABLE":  "${aws_dynamodb_table.findings.name}"
                                                                                                    }
                                                                                  },
                                                                  "depends_on":  [
                                                                                     "aws_iam_role_policy.detector"
                                                                                 ]
                                                              }
                                             },
                     "aws_lambda_event_source_mapping":  {
                                                             "events":  {
                                                                            "event_source_arn":  "${aws_sqs_queue.events.arn}",
                                                                            "function_name":  "${aws_lambda_function.detector.arn}",
                                                                            "batch_size":  5,
                                                                            "function_response_types":  [
                                                                                                            "ReportBatchItemFailures"
                                                                                                        ]
                                                                        }
                                                         },
                     "aws_iam_instance_profile":  {
                                                      "producer":  {
                                                                       "name":  "${local.name}-producer-${var.region}",
                                                                       "role":  "${aws_iam_role.producer.name}"
                                                                   }
                                                  },
                     "aws_security_group":  {
                                                "producer":  {
                                                                 "name":  "${local.name}",
                                                                 "description":  "No inbound access, HTTPS outbound to reach S3",
                                                                 "vpc_id":  "${data.aws_vpc.default.id}"
                                                             }
                                            },
                     "aws_instance":  {
                                          "producer":  {
                                                           "ami":  "${data.aws_ssm_parameter.al2023.value}",
                                                           "instance_type":  "t3.micro",
                                                           "subnet_id":  "${sort(data.aws_subnets.default.ids)[0]}",
                                                           "associate_public_ip_address":  true,
                                                           "vpc_security_group_ids":  [
                                                                                          "${aws_security_group.producer.id}"
                                                                                      ],
                                                           "iam_instance_profile":  "${aws_iam_instance_profile.producer.name}",
                                                           "instance_initiated_shutdown_behavior":  "stop",
                                                           "metadata_options":  {
                                                                                    "http_endpoint":  "enabled",
                                                                                    "http_tokens":  "required",
                                                                                    "http_put_response_hop_limit":  1
                                                                                },
                                                           "root_block_device":  {
                                                                                     "encrypted":  true,
                                                                                     "volume_type":  "gp3",
                                                                                     "volume_size":  8
                                                                                 },
                                                           "credit_specification":  {
                                                                                        "cpu_credits":  "standard"
                                                                                    },
                                                           "user_data":  "${replace(templatefile(\"${path.module}/bootstrap.sh.tftpl\", {generator_base64 = base64encode(file(\"${path.module}/generate_logs.py\")), region = var.region, bucket = aws_s3_bucket.logs.id}), \"\\r\\n\", \"\\n\")}",
                                                           "user_data_replace_on_change":  true,
                                                           "depends_on":  [
                                                                              "aws_s3_bucket_notification.events",
                                                                              "aws_s3_bucket_public_access_block.logs",
                                                                              "aws_s3_bucket_server_side_encryption_configuration.logs",
                                                                              "aws_iam_role_policy.producer",
                                                                              "aws_lambda_event_source_mapping.events"
                                                                          ]
                                                       }
                                      },
                     "aws_vpc_security_group_egress_rule":  {
                                                                "producer_https":  {
                                                                                       "security_group_id":  "${aws_security_group.producer.id}",
                                                                                       "description":  "HTTPS outbound for S3 uploads",
                                                                                       "cidr_ipv4":  "0.0.0.0/0",
                                                                                       "to_port":  443,
                                                                                       "from_port":  443,
                                                                                       "ip_protocol":  "tcp"
                                                                                   }
                                                            }
                 },
    "output":  {
                   "log_bucket":  {
                                      "value":  "${aws_s3_bucket.logs.id}"
                                  },
                   "findings_table":  {
                                          "value":  "${aws_dynamodb_table.findings.name}"
                                      },
                   "detector_log_group":  {
                                              "value":  "${aws_cloudwatch_log_group.detector.name}"
                                          },
                   "instance_id":  {
                                       "value":  "${aws_instance.producer.id}"
                                   }
               }
}
